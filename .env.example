# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secreta: solo en el servidor / Vercel

# Contraseña para entrar al panel
DASHBOARD_PASSWORD=cambia-esto

# Clave que usa la extensión de Chrome para enviar pedidos (genera una larga y aleatoria)
# p. ej.: openssl rand -hex 32
INGEST_API_KEY=

# --- Opcional: sincronización automática (Vercel Cron) ---
CRON_SECRET=
# Endpoint interno de Drop que carga tus órdenes (cópialo de DevTools → Network). {page} = nº de página
DROP_API_ORDERS_URL=
# Cabecera Authorization que envía Drop, ej. "Bearer eyJ..." (caduca: hay que renovarla)
DROP_AUTH_HEADER=
